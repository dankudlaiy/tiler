<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon). -->
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Tiler</RootNamespace>
    <AssemblyName>Tiler</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI awareness has to come from the manifest: this is a WPF app, WinForms only hosts the tray icon. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Tiler.Core\Tiler.Core.csproj" />
  </ItemGroup>

</Project>
